<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CucineCRM.API</RootNamespace>
    <UserSecretsId>c1e1a1a0-0000-4000-8000-000000000001</UserSecretsId>

    <!-- Server GC presuppone molta più RAM di quella disponibile sui piani Free di hosting
         (es. Render, 512 MB): con Workstation GC il runtime si avvia in modo affidabile anche lì. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CucineCRM.Application\CucineCRM.Application.csproj" />
    <ProjectReference Include="..\CucineCRM.Infrastructure\CucineCRM.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
